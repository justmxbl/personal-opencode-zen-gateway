# OpenCode Zen Gateway configuration
# Copy to .env and adjust, or export these in your shell / service unit.

# --- gateway ---------------------------------------------------------------
PORT=8899
HOST=127.0.0.1

# Require clients to send "Authorization: Bearer <key>". Empty = no auth.
# LOCAL_API_KEY=

# --- opencode backend ------------------------------------------------------
# Path to the opencode binary. Leave empty to auto-detect (PATH / npm global).
# OPENCODE_BIN=

# Port for the managed `opencode serve` process.
OPENCODE_SERVER_PORT=4096

# Basic-auth password for the backend. Change it if the port is reachable by
# other users on the machine.
OPENCODE_SERVER_PASSWORD=zen-gateway-local

# Spawn and supervise the backend. Set to "false" to use an external server.
MANAGE_BACKEND=true

# Sandbox working directory for the backend (tool calls are confined here).
# OPENCODE_WORKSPACE=./workspace

# Agent used for prompts. Must keep tools enabled (see README).
OPENCODE_AGENT=zen

# --- probes ----------------------------------------------------------------
# Model used by GET /ready. Empty = first available free model.
# READY_MODEL=
READY_TTL_MS=60000
FREE_MODELS_TTL_MS=300000

# Comma-separated list of models that accept image input.
VISION_MODELS=mimo-v2.5-free

# --- alerts / logging ------------------------------------------------------
# POST a JSON payload here on backend failures, restarts and readiness errors.
# Works with Slack/Discord/generic webhooks.
# ALERT_WEBHOOK=

# GATEWAY_LOG=./gateway.log
